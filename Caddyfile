postmanchat.live, www.postmanchat.live, smart-queue.in, www.smart-queue.in {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /ws* {
        reverse_proxy backend:8080
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
