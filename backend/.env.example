# Copy to backend/.env for local development. Real values come from Supabase, Resend, etc.
DATABASE_URL=jdbc:postgresql://localhost:5432/smartqueue
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

APP_JWT_SECRET=change-this-secret-to-at-least-32-characters
APP_JWT_TTL_MINUTES=720
APP_CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=

ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=

DEV_AUTH_ENABLED=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=Smart Queue <no-reply@smart-queue.in>

FRONTEND_URL=https://smart-queue.in

# Low-memory tuning (see commit d00196b) - defaults are fine for local dev
TOMCAT_MAX_THREADS=20
TOMCAT_MIN_SPARE_THREADS=4
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=2
