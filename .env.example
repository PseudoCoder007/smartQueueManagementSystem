# Copy to .env on the EC2 box, in the same directory as docker-compose.yml
# (~/smartqueue-deploy/.env). Loaded by docker-compose for image tags and by
# the backend service via env_file. Never commit the real file.

# Lowercase GitHub username/org that owns the GHCR packages, e.g. pseudocoder007
GHCR_OWNER=

DATABASE_URL=jdbc:postgresql://<supabase-pooler-host>:5432/postgres?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

APP_JWT_SECRET=
APP_JWT_TTL_MINUTES=720
APP_CORS_ORIGINS=https://smart-queue.in,https://www.smart-queue.in

SUPABASE_URL=
SUPABASE_ANON_KEY=

ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=

DEV_AUTH_ENABLED=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=Smart Queue <no-reply@smart-queue.in>

FRONTEND_URL=https://smart-queue.in

# Low-memory tuning for a 1GB-RAM t3.micro box (see commit d00196b)
TOMCAT_MAX_THREADS=20
TOMCAT_MIN_SPARE_THREADS=4
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=2
